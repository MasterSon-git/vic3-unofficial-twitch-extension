<Window x:Class="Vic3Unofficial.Twitch.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vic3 Unofficial Twitch Desktop Uploader"
        Height="640"
        Width="920"
        MinHeight="560"
        MinWidth="780"
        Background="#F5F6F8">
  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#5B3FF2"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="MinWidth" Value="128"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#C9CBD3"/>
                <Setter Property="Foreground" Value="#6F7380"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#4930D4"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#ECEEF4"/>
      <Setter Property="Foreground" Value="#202330"/>
      <Setter Property="MinWidth" Value="104"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#DDE1EA"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DDE1EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#5C6472"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Height" Value="10"/>
      <Setter Property="Fill" Value="#C9932E"/>
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Victoria 3 Twitch Uploader" FontSize="24" FontWeight="SemiBold" Foreground="#171A22"/>
        <TextBlock Text="{Binding UploadStatusText}" Margin="0,4,0,0" Foreground="#5C6472"/>
      </StackPanel>
      <Button DockPanel.Dock="Right"
              Content="{Binding WatchingButtonText}"
              Command="{Binding ToggleWatchingCommand}"
              Style="{StaticResource PrimaryButton}"
              HorizontalAlignment="Right"/>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.05*"/>
        <ColumnDefinition Width="0.95*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel>
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="Connection" FontSize="16" FontWeight="SemiBold" Foreground="#171A22"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Ellipse>
                  <Ellipse.Style>
                    <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPaired}" Value="True">
                          <Setter Property="Fill" Value="#2F9E44"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ConnectionStatusText}" Margin="8,0,0,0" FontWeight="SemiBold"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>

          <TextBlock Grid.Row="1"
                     Text="{Binding ConnectionDetailText}"
                     Style="{StaticResource MutedText}"
                     Margin="0,12,0,16"/>

          <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Pair" Command="{Binding PairCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="Unpair" Command="{Binding UnpairCommand}" Style="{StaticResource SecondaryButton}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Victoria 3 saves"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#171A22"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshSettingsCommand}"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="84"
                    Padding="12,7"/>
          </Grid>

          <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse>
                <Ellipse.Style>
                  <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSaveFolderReady}" Value="True">
                        <Setter Property="Fill" Value="#2F9E44"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding SaveFolderStatusText}" Margin="8,0,0,0" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="{Binding SaveFormatStatusText}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
          </StackPanel>

          <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SaveDir, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,8"
                     BorderBrush="#CBD1DC"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="Browse"
                    Command="{Binding BrowseSaveFolderCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0"/>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Text="Upload state" FontSize="14" FontWeight="SemiBold" Foreground="#171A22"/>
            <TextBlock Text="{Binding UploadStatusText}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Worker" FontSize="14" FontWeight="SemiBold" Foreground="#171A22"/>
            <TextBlock Text="{Binding ConnectionStatusText}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Save folder" FontSize="14" FontWeight="SemiBold" Foreground="#171A22"/>
            <TextBlock Text="{Binding SaveFolderStatusText}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold" Foreground="#171A22" Margin="0,0,0,12"/>
          <Border Grid.Row="1" BorderBrush="#E4E7EE" BorderThickness="1" CornerRadius="6" Background="#FAFBFD">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding StatusEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="10,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Timestamp.LocalDateTime, StringFormat={}{0:HH:mm:ss}}" Foreground="#7A8190"/>
                      <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="#7A8190"/>
                      <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#202330"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
